# Kopie als webui.env (chmod 600). Keine Werte in Chat oder Repo.
HERMES_WEBUI_ENV=prod
HERMES_WEBUI_AUTH_MODE=oidc
HERMES_WEBUI_PUBLIC_URL=https://agents.thiel.digital
HERMES_WEBUI_ALLOWED_HOSTS=agents.thiel.digital,127.0.0.1,localhost
WEBUI_PORT=8420

# Forgejo als Anmeldung. Redirect-URI der OAuth-App: https://agents.thiel.digital/auth/callback
FORGEJO_ISSUER=https://git.thiel.digital
FORGEJO_OIDC_CLIENT_ID=
FORGEJO_OIDC_CLIENT_SECRET=
# Numerische Forgejo-Benutzer-ID (das `sub` des Tokens); mehrere kommagetrennt.
OIDC_ALLOWED_SUB=

# API_SERVER_KEY des Container-Gateways (hermes-agents). Heißt so, weil hosts.json darauf verweist (api_key_env).
HERMES_KEY_HIKARI=

# Im Multiplex-Gateway hat jedes Profil außer `default` ein eigenes API_SERVER_KEY (in hosts.json: api_key_env je Agent).
# Eintragen mit `bash deploy/profile-keys.sh` (liest aus den Profilordnern, zeigt keine Werte):
# HERMES_KEY_INARI=

# Nur nötig, falls Hindsight einen Key verlangt: in config/memory.json beim Anbieter "api_key_env": "HINDSIGHT_API_KEY" setzen.
# HINDSIGHT_API_KEY=
