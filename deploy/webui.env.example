# Kopie als webui.env (chmod 600). Keine Werte in Chat oder Repo.
HERMES_WEBUI_ENV=prod
HERMES_WEBUI_AUTH_MODE=oidc
HERMES_WEBUI_PUBLIC_URL=https://webui.example.com
HERMES_WEBUI_ALLOWED_HOSTS=webui.example.com,127.0.0.1,localhost
WEBUI_PORT=8420

# Anmeldung über einen OIDC-Anbieter (getestet mit Forgejo). Redirect-URI der OAuth-App: <PUBLIC_URL>/auth/callback
HERMES_WEBUI_OIDC_ISSUER=https://auth.example.com
HERMES_WEBUI_OIDC_CLIENT_ID=
HERMES_WEBUI_OIDC_CLIENT_SECRET=
# Erlaubte Kennungen (das `sub` des ID-Tokens); mehrere kommagetrennt.
HERMES_WEBUI_OIDC_ALLOWED_SUB=

# Optional für die Skripte unter deploy/: Name des Hermes-Containers (docker ps) und dessen Datenordner auf dem Host.
# deploy.sh holt damit den API_SERVER_KEY, profile-keys.sh liest die Profil-Keys.
# HERMES_CONTAINER=
# HERMES_DATA=
# Optional: "name:ip", wenn der Container den OIDC-Anbieter nicht selbst auflösen kann.
# WEBUI_EXTRA_HOST=

# API_SERVER_KEY des Hermes-Gateways. Der Name steht in hosts.json (api_key_env).
HERMES_KEY_LOCAL=

# Mehrere Profile in einem Gateway: deploy/hosts.multiplex.example.json als Vorlage nehmen (Host-Eintrag in config/hosts.json ersetzen).
# Im Multiplex-Gateway hat jedes Profil außer `default` ein eigenes API_SERVER_KEY (in hosts.json: api_key_env je Agent).
# Eintragen mit `bash deploy/profile-keys.sh` (liest aus den Profilordnern, zeigt keine Werte):
# HERMES_KEY_DELTA=

# Nur nötig, falls Hindsight einen Key verlangt: in config/memory.json beim Anbieter "api_key_env": "HINDSIGHT_API_KEY" setzen.
# HINDSIGHT_API_KEY=

# Token des Hermes-Dashboards im Container (SOUL und Profil-Einstellungen). `bash deploy/dashboard.sh` erzeugt ihn und startet das Dashboard.
# HERMES_DASHBOARD_TOKEN=

# Weitere Hosts (Laptop usw.): `bash deploy/add-host.sh laptop "Laptop" 100.64.3.4 [--dashboard-port 9119]` ergänzt hosts.json
# und trägt hier HERMES_KEY_LAPTOP (und mit Dashboard HERMES_DASHBOARD_TOKEN_LAPTOP) ein, ohne Werte auszugeben.
# HERMES_KEY_LAPTOP=

# Anbieter, die diese Installation nicht zeigen soll (Slugs, kommagetrennt). Standard: alle echten Anbieter.
# HERMES_WEBUI_HIDDEN_PROVIDERS=

# Neue Anmeldung (Step-up) vor riskanten Aktionen (Terminal, SOUL, Schluessel). off = nur die normale Anmeldung zaehlt.
# Sinnvoll, wenn die WebUI nur in einem privaten Netz erreichbar ist. Standard: on.
# HERMES_WEBUI_STEP_UP=off
